<rice:RiceWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
                 x:Class="Bolt.App.Views.ConfirmWindow"
                 Width="420" SizeToContent="Height"
                 CanResize="False" CanMinimize="False" CanMaximize="False"
                 ShowThemeToggle="False" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24,20" Spacing="16">
    <TextBlock Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="CancelButton" Content="Mégse" IsCancel="True" MinWidth="96" HorizontalContentAlignment="Center" />
      <Button Name="ConfirmButton" Classes="accent" IsDefault="True" MinWidth="96" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</rice:RiceWindow>
